local M = {}

---@class CmdDef
---@field cmd string The command name to stub
---@field deps? string[] Dependencies to load specifically for this command

---@class KeyDef
---@field [1] string Mode ("n", "v", "i", "t")
---@field [2] string LHS (the keybinding)
---@field desc? string Description for the keymap
---@field deps? string[] Dependencies to load specifically for this keymap

---@class PluginOpts
---@field name string Unique identifier for the plugin
---@field load? fun() Function that adds the package and applies configuration
---@field deps? string[] Global dependencies required before loading this plugin
---@field libs? string[] Global dependencies required before loading this plugin
---@field exts? string[] Plugin specific extensions required by this plugin
---@field cmds? (string|CmdDef)[] List of commands that trigger lazy loading
---@field keys? KeyDef[] List of keybindings that trigger lazy loading
---@field event? string|string[] autocommand events that trigger lazy loading
---@field src? string|string[] URL Link to plugin repository
---@field ft? string[]|table

---@alias SType string # something
---| "nil"
---| "any"
---| "boolean"
---| "string"
---| "number"
---| "integer"
---| "function"
---| "table"
---| "thread"
---| "userdata"
---| "lightuserdata"

-- helpers
---
---@param item SType|SType[] Item to check
---@param accept? SType A lua `type`. Cast `item` of `type accept` to list
---@param except? SType A lua `type`. If item is of this type, function will throw an error
---@return table item -- nil error
---@private
local function tolist(item, accept, except)
	accept = accept or "string"
	except = except or "boolean"
	if type(item) == "table" then
		return item
	end
	if type(item) == accept then
		return { item }
	end
	if type(item) == except then
		error("item is of `except` type " .. except)
	end
	return {}
end

---@private
local function _vimpackadd(opts)
	local packtable = {}
	for k, v in pairs(opts) do
		local fld = k == 1 and "src" or k
		packtable[fld] = v
	end
	return packtable
end

-- Registry for custom settings
local settings_cache = {}

--- Stores the main configuration table.
---@param settings table The settings table to store.
function M.set_settings(settings)
	settings_cache = settings
end

--- Retrieves the stored configuration table.
-- @return table The settings table.
function M.get_settings()
	return settings_cache
end

-- Registry for lazy-loading dependencies
local plugin_loaders = {}

local plugin_libs = {}

function M.get_libs()
	return plugin_libs
end

---Registers a plugin for lazy loading, handling dependencies and command stubs.
---@param opts PluginOpts
function M.register_plugin(opts)
	plugin_loaders[opts.name] = {
		src = _vimpackadd(tolist(opts.src)) or nil,
		load = opts.load,
		deps = tolist(opts.deps) or {},
		libs = tolist(opts.libs) or nil,
		exts = tolist(opts.exts) or nil,
		cmds = tolist(opts.cmds) or nil,
		loaded = false,
	}

	if opts.cmds then
		local cmds = tolist(opts.cmds)
		for _, cmd_def in ipairs(cmds) do
			if type(cmd_def) == "string" then
				M.command_stub(cmd_def, function()
					M.require_plugin(opts.name)
				end)
			elseif type(cmd_def) == "table" and cmd_def.cmd then
				M.command_stub(cmd_def.cmd, function()
					if cmd_def.deps then
						for _, dep in ipairs(cmd_def.deps) do
							M.require_plugin(dep)
						end
					end
					M.require_plugin(opts.name)
				end)
			end
		end
	end
	if opts.keys then
		for _, key_def in ipairs(opts.keys) do
			local mode, lhs = key_def[1], key_def[2]
			M.keymap_stub(mode, lhs, function()
				if key_def.deps then
					for _, dep in ipairs(key_def.deps) do
						M.require_plugin(dep)
					end
				end
				M.require_plugin(opts.name)
			end, { desc = key_def.desc })
		end
	end
	if opts.ft then
		local ft = tolist(opts.ft)
		M.lazy_on_filetype(opts.name, ft, function()
			M.require_plugin(opts.name)
		end)
	end
	if opts.event then
		M.lazy_on_event(opts.name, opts.event, function()
			M.require_plugin(opts.name)
		end)
	end
end

---Forces a plugin and its dependencies to load if not already loaded.
---@param name string The name of the registered plugin
function M.require_plugin(name)
	local plugin = plugin_loaders[name]
	if plugin and not plugin.loaded then
		for _, dep in ipairs(plugin.deps) do
			M.require_plugin(dep)
		end

		if plugin.exts ~= nil then
			for _, ext in ipairs(plugin.exts) do
				vim.pack.add({ _vimpackadd(tolist(ext)) })
			end
		end

		if plugin.libs ~= nil then
			for _, lib in ipairs(plugin.libs) do
				M.require_libs(lib)
			end
		end

		if plugin.src ~= nil then
			local opts = _vimpackadd(tolist(plugin.src))
			vim.pack.add({ opts })
		end

		if plugin.load ~= nil then
			plugin.load()
		end

		plugin.loaded = true
	elseif not plugin then
		vim.notify(
			"Dependency loader for '" .. name .. "' not found.",
			vim.log.levels.WARN
		)
	end
end

---Registers a simple Dependency. Only calls pack.add on opts.src
---@param opts PluginOpts
---| string opts.src
function M.register_deps(opts)
	local function pack()
		vim.pack.add({ { src = opts.src } })
	end

	plugin_loaders[opts.name] = {
		load = pack,
		deps = opts.deps or {},
		loaded = false,
	}
end

function M.require_libs(name)
	local lib = plugin_libs[name]
	if lib and not lib.loaded then
		vim.pack.add({ lib.src })
		lib.loaded = true
	elseif not lib then
		vim.notify(
			"Library loader for '" .. name .. "' not found.",
			vim.log.levels.WARN
		)
	end
end

---Register plugin depenant libraries separatly from Dependencies. Only calls pack.add on opts.src
---@param opts PluginOpts
---| string opts.src
function M.register_libs(opts)
	plugin_libs[opts.name] = {
		src = _vimpackadd(tolist(opts.src)),
		-- deps = opts.deps or {},
		loaded = false,
	}
end

--- Loads a specific list of modules from a given subdirectory.
---@param subdir string: The subdirectory within /lua
---@param modules table: A list of module names to load from that subdir.
function M.load_modules(subdir, modules)
	for _, module_name in ipairs(modules) do
		local full_module_path = subdir .. "." .. module_name

		-- pcall safely loads the code. If a file has an
		-- error, it won't crash Neovim.
		local ok, err = pcall(require, full_module_path)
		if not ok then
			vim.notify(
				"Error loading module: " .. full_module_path .. "\n" .. err,
				vim.log.levels.ERROR
			)
		end
	end
end

--- Combines `M.load_modules()` and `M.register_plugin()`
---@param subdir string: The subdirectory within /lua
---@param modules table: A list of module names to load from that subdir.
function M.init_cache_modules(subdir, modules)
	for _, module_name in ipairs(modules) do
		local full_module_path = subdir .. "." .. module_name

		local ok, res_or_err = pcall(require, full_module_path)
		if not ok then
			return vim.notify(
				"Error loading module: " .. full_module_path .. "\n" .. res_or_err,
				vim.log.levels.ERROR
			)
		end

		local opts = {}
		for k, v in pairs(res_or_err) do
			opts[k] = v
		end
		M.register_plugin(opts)
	end
end

---Creates a self-cleaning autocommand to lazy-load a plugin on a
---specific filetype.
---@param plugin_name string: A unique name (e.g., "Colorize") for the augroup.
---@param patterns table: A list of filetype patterns (e.g., {"css", "html"}).
---@param load_callback function: The function to run, which should
---       call vim.pack.add(...) and require(...).setup().
function M.lazy_on_filetype(plugin_name, patterns, load_callback)
	local augroup_name = "LazyLoad" .. plugin_name
	local augroup = vim.api.nvim_create_augroup(augroup_name, { clear = true })

	vim.api.nvim_create_autocmd("FileType", {
		group = augroup,
		pattern = patterns,
		once = true,
		callback = function(args)
			vim.defer_fn(function()
				vim.notify(
					"Loading " .. plugin_name .. "...",
					vim.log.levels.INFO,
					{
						title = "Plugins",
					}
				)
			end, 0)

			load_callback(args)
		end,
	})
end

---Triggers the "User VeryLazy" event shortly after startup to optimize UI responsiveness.
function M.setup_very_lazy()
	vim.api.nvim_create_autocmd("VimEnter", {
		once = true,
		callback = function()
			-- Defer execution to unblock the main thread during startup
			vim.defer_fn(function()
				vim.api.nvim_exec_autocmds("User", { pattern = "VeryLazy" })
			end, 20)
		end,
	})
end

---Creates a self-cleaning autocommand to lazy-load a plugin on a specific event.
---@param plugin_name string: A unique name (e.g., "Blink") for the augroup.
---@param event string|table: The event(s) to trigger loading (e.g., "InsertEnter" or "User VeryLazy").
---@param load_callback function: The function to run, which should call
function M.lazy_on_event(plugin_name, event, load_callback)
	local augroup_name = "LazyLoad" .. plugin_name
	local augroup = vim.api.nvim_create_augroup(augroup_name, { clear = true })

	-- "user [pattern]" custom user events
	local actual_event = event
	local evt_pattern = nil
	if type(event) == "string" and event:match("^User ") then
		actual_event = "User"
		evt_pattern = event:gsub("^User ", "")
	end

	vim.api.nvim_create_autocmd(actual_event, {
		group = augroup,
		pattern = evt_pattern,
		once = true,
		callback = function(args)
			vim.defer_fn(function()
				vim.notify(
					"Loading " .. plugin_name .. "...",
					vim.log.levels.INFO,
					{
						title = "Plugins",
					}
				)
			end, 0)

			load_callback(args)
		end,
	})
end

---Creates a "stub" keymap that loads a plugin on its first use.
---@param mode string|table: The keymap mode (e.g., "n", { "n", "v" })
---@param lhs string: The left-hand side of the keymap
---@param load_callback function: A function that loads the plugin and
---       re-defines the keymap to its *real* function.
---@param opts table: Standard keymap options (e.g., { desc = "..." })
function M.keymap_stub(mode, lhs, load_callback, opts)
	opts = opts or {}
	opts.desc = (opts.desc or "lazy-stub") .. " (lazy)"

	vim.keymap.set(mode, lhs, function()
		vim.keymap.del(mode, lhs)
		load_callback()
		local keys = vim.api.nvim_replace_termcodes(lhs, true, false, true)
		vim.api.nvim_input(keys) -- Replay the keypress
	end, opts)
end

---Creates a "stub" command that loads a plugin on its first use.
---@param command_name string: The name of the User command (e.g., "FzfLua")
---@param load_callback function: A function that loads the plugin and
---       re-defines this command.
function M.command_stub(command_name, load_callback)
	vim.api.nvim_create_user_command(command_name, function(args)
		vim.api.nvim_del_user_command(command_name)
		load_callback()
		-- Re-run the command with original args
		vim.cmd(command_name .. " " .. (args.args or ""))
	end, {
		nargs = "*",
	})
end

-- [Keep all functions above M.command_stub] --

---Creates a controller to Lazy-Load and Toggle a plugin.
---It defines a command :{Name}Toggle automatically.
---@param name string: The display name of the plugin (e.g., "Copilot")
---@param opts table: Lifecycle functions
---    - load: function() -> Code to packadd/setup the plugin (runs once)
---    - enable: function() -> Code to enable the plugin (runs on toggle ON)
---    - disable: function() -> Code to disable the plugin (runs on toggle OFF)
---@return function: The 'load' function, so you can use it in other stubs.
function M.create_toggle_controller(name, opts)
	-- Internal state for this specific plugin
	local state = {
		loaded = false,
		enabled = false,
	}

	-- The core loading logic
	local function load_plugin()
		if state.loaded then
			return
		end
		-- 1. Run the user's load function (packadd + setup)
		opts.load()
		state.loaded = true
		state.enabled = true -- We assume setup() enables it by default
	end

	vim.api.nvim_create_user_command(name .. "Toggle", function()
		-- Not loaded yet? Load it.
		if not state.loaded then
			load_plugin()
			vim.notify(
				name .. " Loaded & Enabled",
				vim.log.levels.INFO,
				{ title = "Plugins" }
			)
			return
		end

		-- Already loaded? Toggle it.
		if state.enabled then
			if opts.disable then
				opts.disable()
			end
			state.enabled = false
			vim.notify(
				name .. " Disabled",
				vim.log.levels.WARN,
				{ title = "Plugins" }
			)
		else
			if opts.enable then
				opts.enable()
			end
			state.enabled = true
			vim.notify(
				name .. " Enabled",
				vim.log.levels.INFO,
				{ title = "Plugins" }
			)
		end
	end, { desc = "Lazy-Load / Toggle " .. name })

	-- Return the load function to attach it to other commands
	return load_plugin
end

function M.nmap(lhs, rhs, opt)
	vim.keymap.set("n", lhs, rhs, opt)
end

function M.imap(lhs, rhs, opt)
	vim.keymap.set("i", lhs, rhs, opt)
end

function M.vmap(lhs, rhs, opt)
	vim.keymap.set("v", lhs, rhs, opt)
end

---@param hl_map table Key: Highlight group. Value: Highlight options.
function M.set_highlights(hl_map)
	return function()
		for hl_group, color_opts in pairs(hl_map) do
			vim.api.nvim_set_hl(0, hl_group, color_opts)
		end
	end
end

function M.bind_map_pre_stub(map_func, mappings, options, pre_func)
	for keybind, target_func in pairs(mappings) do
		local operation = function()
			if pre_func then
				pre_func()
			end
			target_func(options)
		end
		map_func(keybind, operation)
	end
end

--- Retrieves the registered plugins table.
---@return table
function M.get_plugins()
	return plugin_loaders
end

--- Extracts and sorts registry status lines for UI consumption.
---@param registry table The registry to query (plugins or libs)
---@return table lines Array of formatted strings
function M.format_registry_status(registry)
	local lines = {}
	for name, opts in pairs(registry) do
		local status = opts.loaded and "[✓]" or "[ ]"
		table.insert(lines, string.format("%s %s", status, name))
	end
	table.sort(lines)
	return lines
end

return M
